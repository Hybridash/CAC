# Settings baked into the Bio Bites iPhone/iPad app (npm run ios).
# The server the app talks to. localhost works in the iOS Simulator (it shares your Mac's network).
# For a real iPhone, use your Mac's Wi-Fi address (e.g. http://192.168.1.50:3000) or an https:// host.
VITE_API_URL=http://localhost:3000
# Google sign-in: the iOS OAuth client ID from Google Cloud Console (see README → Sign in)
VITE_GOOGLE_IOS_CLIENT_ID=
