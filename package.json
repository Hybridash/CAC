{
  "name": "bioplay",
  "version": "0.3.0",
  "private": true,
  "description": "BioPlay \u2014 interactive biology made simple",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "NODE_ENV=production npm run start -w server",
    "test": "npm run test -w shared && npm run test -w server && npm run test -w client",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app": "node scripts/app.mjs",
    "ios": "node scripts/ios.mjs",
    "ios:live": "node scripts/ios.mjs --live",
    "backup": "node scripts/backup-db.mjs",
    "audit": "npm audit --audit-level=high",
    "test:security": "npm run test -w server -- security"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
