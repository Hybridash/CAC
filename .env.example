# Copy to server/.env (never commit the real file; .env is git-ignored).
# Everything here is read by the SERVER only. Nothing in this file is ever sent to browsers.

# --- Basics ---
PORT=3001
# SQLite database file. Keep it outside any web-served folder; back it up with `npm run backup`.
DATABASE_PATH=./data/bioplay.db
# The web origin allowed to call the API from a browser (the dev client, or your https site).
CLIENT_ORIGIN=http://localhost:5173
# Set to "production" when deployed: enables HSTS, hides process details, disables the demo login.
# NODE_ENV=production

# --- Behind a reverse proxy / load balancer? ---
# Number of proxies in front of this server (usually 1). Leave 0 if clients connect directly:
# anything else lets clients forge X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=0

# --- Sign in with Google / Apple (public client IDs only; these are not secrets) ---
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Bio Bot (AI tutor). SECRET: keep it in the server environment only. ---
# Never put this key in a VITE_* variable or any client file. Leave empty to switch Bio Bot off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Questions per player per UTC day, and a hard server-wide ceiling per day (caps your AI bill).
CHAT_DAILY_LIMIT=30
CHAT_GLOBAL_DAILY_LIMIT=3000

# --- Demo login (demo@gmail.com / demo123: a PUBLIC password) ---
# On by default in development, OFF in production unless you set it to "on" deliberately.
DEMO_ACCOUNT=on
# The login form shows its one-tap demo button in dev builds, or when the client is built with
# VITE_SHOW_DEMO_LOGIN=on (a public, non-secret flag). Leave both off for a real launch.

# --- Logging ---
# Security events (failed logins, rate limits, denied access) are printed as JSON lines.
# Set to "off" to silence them.
SECURITY_LOG=on
