# Server port for the BioPlay API
PORT=3001
# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/bioplay.db
# Origin allowed to call the API in development
CLIENT_ORIGIN=http://localhost:5173
# Sign in with Google: comma-separated OAuth client IDs whose tokens are accepted
# (the iOS client ID, plus the web client ID if you sign in on the website too)
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the app's bundle ID (com.biobites.app), plus a Services ID for the website
APPLE_CLIENT_IDS=
