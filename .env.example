# Server port for the BioPlay API
PORT=3001
# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/bioplay.db
# Origin allowed to call the API in development
CLIENT_ORIGIN=http://localhost:5173
# Sign in with Google: comma-separated OAuth client IDs whose tokens are accepted
# (the iOS client ID, plus the web client ID if you sign in on the website too)
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the app's bundle ID (com.biobites.app), plus a Services ID for the website
APPLE_CLIENT_IDS=
# Bio Bot (AI tutor): a Google Gemini API key. Leave empty to keep Bio Bot switched off.
# Check the Gemini API terms first: they restrict apps likely to be used by people under 18.
GEMINI_API_KEY=
# Optional: which Gemini model to use, and how many questions each player may ask per day
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_DAILY_LIMIT=30
# Create the demo login (demo@gmail.com / demo123) on startup. Set to off on a public server.
DEMO_ACCOUNT=on
