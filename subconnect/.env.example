# PostgreSQL connection string. `npm run db:local` starts an embedded Postgres matching this URL.
DATABASE_URL="postgresql://subconnect:subconnect@localhost:5433/subconnect"

# Public base URL of the app (used in email links and origin checks)
APP_URL="http://localhost:3000"

# Session lifetime in hours
SESSION_TTL_HOURS=12

# File storage: "local" (private folder on disk, dev only) or "s3"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, ...). Bucket must be private.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# Optional email notifications. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SubConnect <no-reply@example.org>"
